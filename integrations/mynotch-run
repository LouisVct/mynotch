#!/usr/bin/env bash
# Runs any command and shows it in the notch: spinner while it runs, then green (ok) or orange (failed).
#
#   mynotch-run --name "Build" -- make all
#   mynotch-run --name "Aider" -- aider
#
# Standard input / output stay attached to your terminal, so interactive tools work normally.
here="$(cd "$(dirname "$0")" && pwd)"

name="Command"
while [ $# -gt 0 ]; do
  case "$1" in
    --name) name="${2:-}"; shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
[ $# -eq 0 ] && { echo "usage: mynotch-run [--name NAME] -- command [args...]" >&2; exit 2; }

session="$name:$$"
"$here/mynotch-notify" --name "$name" --state working --session "$session"
"$@"
code=$?
if [ $code -eq 0 ]; then
  "$here/mynotch-notify" --name "$name" --state done --session "$session" --message "Finished"
else
  "$here/mynotch-notify" --name "$name" --state input --session "$session" --message "Failed (exit $code)"
fi
exit $code
